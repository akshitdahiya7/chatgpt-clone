# ---- Server ----
ENV=DEV
PORT=8002

# ---- OpenAI (embeddings + LLM) ----
OPENAI_API_KEY=<your openai key>
# Leave empty for OpenAI itself. Set to an OpenAI-compatible endpoint to use one.
OPENAI_BASE_URL=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match what the model returns, and is frozen once the index exists.
# text-embedding-3-small=1536, all-MiniLM-L6-v2=384
EMBEDDING_DIMENSION=1536

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ---- Vector store ----
# "qdrant"     free tier, no expiry, nothing to pay
# "opensearch" AWS, ~$26/month, cannot be paused once created
VECTOR_STORE_PROVIDER=qdrant
VECTOR_INDEX_NAME=documents

# Drop chunks scoring below this so unrelated text never reaches the model.
# Both providers are rescaled to the same 0-1 range, so one value works for
# either. Retune if you change the embedding model or document type.
RAG_MIN_SCORE=0.58

# ---- Qdrant Cloud (active) ----
# From cloud.qdrant.io after creating a free cluster. Include https://
QDRANT_URL=https://<cluster-id>.<region>.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=<api key>

# ---- AWS OpenSearch (kept for reference; set VECTOR_STORE_PROVIDER=opensearch to use) ----
# Host only: copy "Domain endpoint (IPv4)" and drop the https:// prefix.
# OPENSEARCH_HOST=<search-xxxx.us-east-1.es.amazonaws.com>
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=<master password>
