# ---- Server ----
ENV=DEV
PORT=8002

# ---- OpenAI (embeddings + LLM) ----
OPENAI_API_KEY=<your openai key>
# Leave empty for OpenAI itself. Set to an OpenAI-compatible endpoint to use one.
OPENAI_BASE_URL=

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match what the model returns, and is frozen once the index exists.
# text-embedding-3-small=1536, all-MiniLM-L6-v2=384
EMBEDDING_DIMENSION=1536

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini

# ---- OpenSearch (vector store) ----
VECTOR_STORE_PROVIDER=opensearch
# Bare host: copy "Domain endpoint (IPv4)" and drop the https:// prefix
OPENSEARCH_HOST=<search-xxxx.us-east-1.es.amazonaws.com>
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=<master password>
VECTOR_INDEX_NAME=documents
